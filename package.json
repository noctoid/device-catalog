{
  "name": "device-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @device-catalog/desktop",
    "build": "npm run build --workspace @device-catalog/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @device-catalog/core",
    "tauri:dev": "npm run tauri dev --workspace @device-catalog/desktop",
    "tauri:build": "npm run tauri build --workspace @device-catalog/desktop"
  }
}
